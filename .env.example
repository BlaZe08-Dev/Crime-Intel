# CrimeIntel environment configuration
#
# Copy this file to `.env` (next to the executable, or in the project root when
# running via `flutter run`) and fill in local values. `.env` is git-ignored and
# must never be committed - docs/Rules.md section 14.

# --- Local LLM (Ollama) ---
# Point OLLAMA_BASE_URL at another machine on the LAN to offload inference.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=granite4.1:3b
OLLAMA_EMBED_MODEL=nomic-embed-text
LLM_TIMEOUT_SECONDS=180
EMBED_TIMEOUT_SECONDS=60

# --- Retrieval (RAG) ---
# How many records are handed to the model as grounding context.
RAG_TOP_K=6
# Cosine similarity floor. Below this, retrieval counts as empty and the
# assistant answers "I don't find that in the database."
RAG_MIN_SCORE=0.35

# --- Secrets ---
# Resend transactional email key for OTP registration. Leave blank to use the
# clearly labelled in-app demo fallback. Resend test sender onboarding@resend.dev
# can deliver only to the email address on the Resend account until a domain is verified.
RESEND_API_KEY=
# Set true to intentionally show each generated registration code in the app.
# Never enable this in a production deployment.
DEMO_MODE=false

APP_ENV=development
