# CrimeIntel Environment Configuration
# Copy this file to .env and fill in real values where needed

# Ollama LLM Configuration (Default local 3B model)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b
OLLAMA_EMBED_MODEL=nomic-embed-text

# Plunk Transactional Email API Key for OTP fallback (Optional/Local only)
PLUNK_API_KEY=

# Application Environment (development / production)
APP_ENV=development
